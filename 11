        function renderDashboard() {
            const running = mockData.containers.filter(c => c.status === 'running').length;
            const stopped = mockData.containers.length - running;

            document.getElementById('runningCount').textContent = running;
            document.getElementById('stoppedCount').textContent = stopped;
            document.getElementById('totalImages').textContent = mockData.images.length;
            document.getElementById('totalVolumes').textContent = mockData.volumes.length;

            renderCharts();
        }

        function renderCharts() {
            // Resource Chart
            const resourceCtx = document.getElementById('resourceChart');
            if (charts.resource) charts.resource.destroy();
            charts.resource = new Chart(resourceCtx, {
                type: 'bar',
                data: {
                    labels: mockData.containers.map(c => c.name),
                    datasets: [
                        {
                            label: 'CPU %',
                            data: mockData.containers.map(c => c.cpu),
                            backgroundColor: 'rgba(37, 99, 235, 0.6)',
                            borderColor: 'rgb(37, 99, 235)',
                            borderWidth: 1
                        },
                        {
                            label: 'Memory MB',
                            data: mockData.containers.map(c => c.memory / 10),
                            backgroundColor: 'rgba(16, 185, 129, 0.6)',
                            borderColor: 'rgb(16, 185, 129)',
                            borderWidth: 1
                        }
                    ]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: true,
                    plugins: {
                        legend: { labels: { color: '#cbd5e1' } }
                    },
                    scales: {
                        y: {
                            ticks: { color: '#94a3b8' },
                            grid: { color: '#475569' }
                        },
                        x: {
                            ticks: { color: '#94a3b8' },
                            grid: { display: false }
                        }
                    }
                }
            });

            // Status Chart
            const statusCtx = document.getElementById('statusChart');
            if (charts.status) charts.status.destroy();
            const running = mockData.containers.filter(c => c.status === 'running').length;
            const stopped = mockData.containers.length - running;

            charts.status = new Chart(statusCtx, {
                type: 'doughnut',
                data: {
                    labels: ['Running', 'Stopped'],
                    datasets: [{
                        data: [running, stopped],
                        backgroundColor: ['#10b981', '#ef4444'],
                        borderColor: '#1e293b',
                        borderWidth: 2
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: true,
                    plugins: {
                        legend: { labels: { color: '#cbd5e1' } }
                    }
                }
            });
        }

        // Containers
        function renderContainers() {
            const list = document.getElementById('containersList');
            list.innerHTML = '<div class="section-title">📦 Running Containers</div>' + 
                mockData.containers.map(c => `
                    <div class="container-item" onclick="showContainerDetails('${c.id}')">
                        <div class="container-info">
                            <div class="container-name">${c.name}</div>
                            <div class="container-id">ID: ${c.id}</div>
                            <div class="container-meta">
                                <span class="meta-item">📦 ${c.image}</span>
                                <span class="meta-item">🔌 ${c.port}</span>
                                <span class="meta-item">📅 ${c.created}</span>
                            </div>
                        </div>
                        <div style="text-align: right;">
                            <span class="badge ${c.status === 'running' ? 'badge-success' : 'badge-danger'}">
                                <span class="status-dot ${c.status === 'running' ? 'status-running' : 'status-exited'}"></span>
                                ${c.status.toUpperCase()}
                            </span>
                            <div style="margin-top: 8px; display: flex; gap: 8px; justify-content: flex-end;">
                                <button class="btn btn-sm btn-secondary" onclick="event.stopPropagation(); mockAction('View Logs')">📋</button>
                                <button class="btn btn-sm btn-secondary" onclick="event.stopPropagation(); mockAction('${c.status === 'running' ? 'Stop' : 'Start'}')">⏹️</button>
                            </div>
                        </div>
                    </div>
                `).join('');
        }

        // Images
        function renderImages() {
            const list = document.getElementById('imagesList');
            list.innerHTML = '<div class="section-title">🖼️ Available Images</div>' + 
                mockData.images.map(img => `
                    <div class="container-item">
                        <div class="container-info">
                            <div class="container-name">${img.name}</div>
                            <div class="container-meta">
                                <span class="meta-item">💾 ${img.size}</span>
                                <span class="meta-item">📅 ${img.pulled}</span>
                                <span class="meta-item">🏷️ ${img.tags}</span>
                            </div>
                        </div>
                        <div style="text-align: right; display: flex; gap: 8px;">
                            <button class="btn btn-secondary" onclick="mockAction('Pull ' + '${img.name}')">⬇️ Pull</button>
                            <button class="btn btn-danger" onclick="mockAction('Remove ' + '${img.name}')">🗑️</button>
                        </div>
                    </div>
                `).join('');
        }

        // Networks
        function renderNetworks() {
            const list = document.getElementById('networksList');
            list.innerHTML = '<div class="section-title">🌐 Networks</div>' + 
                mockData.networks.map(net => `
                    <div class="container-item">
                        <div class="container-info">
                            <div class="container-name">${net.name}</div>
                            <div class="container-meta">
                                <span class="meta-item">🔗 ${net.driver}</span>
                                <span class="meta-item">📦 ${net.containers} containers</span>
                                <span class="meta-item">📅 ${net.created}</span>
                            </div>
                        </div>
                        <div style="text-align: right;">
                            <button class="btn btn-secondary" onclick="mockAction('Inspect ' + '${net.name}')">🔍 Inspect</button>
                        </div>
                    </div>
                `).join('');
        }

        // Volumes
        function renderVolumes() {
            const list = document.getElementById('volumesList');
            list.innerHTML = '<div class="section-title">💾 Volumes</div>' + 
                mockData.volumes.map(vol => `
                    <div class="container-item">
                        <div class="container-info">
                            <div class="container-name">${vol.name}</div>
                            <div class="container-meta">
                                <span class="meta-item">🔗 ${vol.driver}</span>
                                <span class="meta-item">💾 ${vol.size}</span>
                                <span class="meta-item">📦 ${vol.containers} container(s)</span>
                                <span class="meta-item">📅 ${vol.created}</span>
                            </div>
                        </div>
                        <div style="text-align: right; display: flex; gap: 8px;">
                            <button class="btn btn-secondary" onclick="mockAction('Inspect ' + '${vol.name}')">🔍</button>
                            <button class="btn btn-danger" onclick="mockAction('Remove ' + '${vol.name}')">🗑️</button>
                        </div>
                    </div>
                `).join('');
        }

        // Modal Functions
        function openModal(modalId) {
            document.getElementById(modalId).classList.add('active');
        }

        function closeModal(modalId) {
            document.getElementById(modalId).classList.remove('active');
        }

        function showContainerDetails(id) {
            selectedContainer = mockData.containers.find(c => c.id === id);
            if (!selectedContainer) return;

            document.getElementById('detailsTitle').textContent = `${selectedContainer.name} - Details`;
            document.getElementById('detailsBody').innerHTML = `
                <div>
                    <label>Container ID</label>
                    <input type="text" value="${selectedContainer.id}" readonly>
                </div>
                <div>
                    <label>Image</label>
                    <input type="text" value="${selectedContainer.image}" readonly>
                </div>
                <div>
                    <label>Status</label>
                    <input type="text" value="${selectedContainer.status.toUpperCase()}" readonly>
                </div>
                <div>
                    <label>Port Mapping</label>
                    <input type="text" value="${selectedContainer.port}" readonly>
                </div>
                <div>
                    <label>Recent Logs</label>
                    <div class="logs-container">
                        <div class="log-line log-success">[INFO] Container started successfully</div>
                        <div class="log-line">[INFO] Listening on port ${selectedContainer.port.split(':')[0]}</div>
                        <div class="log-line">[INFO] All systems operational</div>
                    </div>
                </div>
            `;

            const toggleBtn = document.getElementById('toggleBtn');
            toggleBtn.textContent = selectedContainer.status === 'running' ? '⏹️ Stop' : '▶️ Start';

            openModal('containerDetails');
        }

        function createContainer() {
            const name = document.getElementById('containerName').value;
            const image = document.getElementById('imageName').value;
            if (!name || !image) {
                alert('Please fill in all required fields');
                return;
            }
            mockAction(`Created container: ${name}`);
            closeModal('newContainer');
            document.getElementById('containerName').value = '';
            document.getElementById('imageName').value = '';
        }

        function toggleContainer() {
            if (selectedContainer) {
                mockAction(`${selectedContainer.status === 'running' ? 'Stopped' : 'Started'} ${selectedContainer.name}`);
                selectedContainer.status = selectedContainer.status === 'running' ? 'exited' : 'running';
                closeModal('containerDetails');
                renderContainers();
                renderDashboard();
            }
        }

        function deleteContainer() {
            if (selectedContainer && confirm(`Delete ${selectedContainer.name}?`)) {
                mockAction(`Deleted ${selectedContainer.name}`);
                mockData.containers = mockData.containers.filter(c => c.id !== selectedContainer.id);
                closeModal('containerDetails');
                renderContainers();
                renderDashboard();
            }
        }

        function mockAction(action) {
            alert(`✅ ${action}\n\nThis is a demo. In production, this would execute actual Docker commands.`);
        }

        function refreshAll() {
            renderDashboard();
            renderContainers();
            renderImages();
            renderNetworks();
            renderVolumes();
            mockAction('Data refreshed');
        }
    </script>
</body>
</html>
